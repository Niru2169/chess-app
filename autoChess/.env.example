# Django
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=dev-change-me
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# AutoChess
AUTOCHESS_STOCKFISH_PATH=stockfish
AUTOCHESS_DEFAULT_MOVETIME_MS=150
AUTOCHESS_MAX_PLIES=600

# Rating system
AUTOCHESS_RATE_ENGINES=1
AUTOCHESS_BAYESELO_PRIOR_STD=300

# GNN prediction (optional: needs torch + the BayesianELO model checkpoint).
# The defaults point at ../BayesianELO-main/gnn-chess relative to the project root.
AUTOCHESS_GNN_ENABLED=1
AUTOCHESS_GNN_TOP_P=0.9
AUTOCHESS_GNN_REFRESH_MS=1500
# Minimax search width for the GNN engine: children are kept while their
# cumulative path probability is >= this (smaller = wider/slower search).
AUTOCHESS_GNN_MIN_PROB=0.001
# AUTOCHESS_GNN_DIR=../BayesianELO-main/gnn-chess
# AUTOCHESS_GNN_MODEL=
